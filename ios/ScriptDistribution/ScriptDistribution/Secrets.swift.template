import Foundation

enum Secrets {
    /// Used as AES-256 key. Android takes the LAST 32 characters via `takeLast(32)`.
    static let encryptionKey = "your_32_char_aes_encryption_key_"

    /// Used as AES IV. Android takes the FIRST 16 characters via `take(16)`.
    static let ivKey = "your_16_char_iv_"

    /// Salt appended to body+moduledata before SHA-256 hashing for the `bodyhash` header.
    static let salt = "your_salt_hex_here"
}
